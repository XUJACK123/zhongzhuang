<launch>
  <param name="robot_description" textfile="$(find fourth_version)/urdf/fourth_version.urdf" />
  <node name="joint_state_publisher_gui" pkg="joint_state_publisher_gui" type="joint_state_publisher_gui">
    <rosparam param="zeros">{lf0_Joint: 0.69865982472146, lf1_Joint: 0.0, l_wheel_Joint: 0.0, rf0_Joint: -0.69865982472146, rf1_Joint: 0.0, r_wheel_Joint: 0.0}</rosparam>
  </node>
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />
  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find fourth_version)/config/display.rviz" />
</launch>
