{
    "configurations": [
        {
            "name": "STM32H723VG GCC",
            "compilerPath": "${config:cortex-debug.armToolchainPath.windows}/arm-none-eabi-gcc.exe",
            "compilerArgs": [
                "-mcpu=cortex-m7",
                "-mthumb",
                "-mfpu=fpv5-d16",
                "-mfloat-abi=hard"
            ],
            "intelliSenseMode": "gcc-arm",
            "includePath": [
                "${workspaceFolder}/Core/Inc",
                "${workspaceFolder}/Drivers/STM32H7xx_HAL_Driver/Inc",
                "${workspaceFolder}/Drivers/CMSIS/Include",
                "${workspaceFolder}/Drivers/CMSIS/Device/ST/STM32H7xx/Include"
            ],
            "defines": [
                "USE_HAL_DRIVER",
                "STM32H723xx",
                "USE_PWR_LDO_SUPPLY",
                "HSE_VALUE=24000000UL"
            ],
            "cStandard": "c11",
            "cppStandard": "c++17"
        }
    ],
    "version": 4
}
