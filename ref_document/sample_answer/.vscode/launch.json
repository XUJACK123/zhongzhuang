{
    // 启动调试的快捷键是 F5
    "version": "0.2.0",
    "configurations": [
        // 1. ST-Link 烧录并调试（最常用：会自动编译、烧录Flash并停在 main）
        {
            "name": "STLink",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/basic_framework.elf",
            "request": "launch",
            "type": "cortex-debug",
            "device": "STM32F407IG",
            "svdFile": "STM32F407.svd",
            "servertype": "openocd",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "runToEntryPoint": "main",
            "rtos": "FreeRTOS",
            "preLaunchTask": "build task", // 调试前先自动运行编译任务
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
        // 2. ST-Link 只连接不复位（芯片正在运行时，直接挂载上去看变量，不重新烧录）
        {
            "name": "STLink-Attach",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/basic_framework.elf",
            "request": "attach",
            "type": "cortex-debug",
            "device": "STM32F407IG",
            "svdFile": "STM32F407.svd",
            "servertype": "openocd",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ]
        }
    ]
}