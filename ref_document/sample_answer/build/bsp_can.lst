  40:bsp/bsp_can.c **** HAL_StatusTypeDef CANTransmit(CANInstance *instance)
  41:bsp/bsp_can.c **** {
  42:bsp/bsp_can.c ****     if (HAL_CAN_GetTxMailboxesFreeLevel(instance->can_handle) == 0) return HAL_BUSY;
  43:bsp/bsp_can.c ****     return HAL_CAN_AddTxMessage(instance->can_handle, &instance->txconf,
  44:bsp/bsp_can.c ****                                 instance->tx_buff, &instance->tx_mailbox);
  45:bsp/bsp_can.c **** }
  46:bsp/bsp_can.c **** 
  47:bsp/bsp_can.c **** void CANSetMotorCurrent(CANInstance *instance, uint8_t id, int16_t current)
  48:bsp/bsp_can.c **** {
  49:bsp/bsp_can.c ****     if (id < 1 || id > 4) return;
  50:bsp/bsp_can.c ****     if (current > 16384) current = 16384;
  51:bsp/bsp_can.c ****     if (current < -16384) current = -16384;
  52:bsp/bsp_can.c ****     instance->tx_buff[(id - 1) * 2] = (uint16_t)current >> 8;
  53:bsp/bsp_can.c ****     instance->tx_buff[(id - 1) * 2 + 1] = (uint16_t)current & 0xFF;
  54:bsp/bsp_can.c **** }
  55:bsp/bsp_can.c **** 
  56:bsp/bsp_can.c **** void CANGetMotorFeedback(MotorFeedback *out)
  57:bsp/bsp_can.c **** {
  58:bsp/bsp_can.c ****     uint32_t mask = __get_PRIMASK();
  59:bsp/bsp_can.c ****     __disable_irq();
  60:bsp/bsp_can.c ****     *out = feedback;
  61:bsp/bsp_can.c ****     __set_PRIMASK(mask);
  62:bsp/bsp_can.c **** }
