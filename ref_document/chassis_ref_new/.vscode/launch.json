{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "RL: DAP flash and run",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/rl/wheel_leg_rl.elf",
      "servertype": "openocd",
      "serverpath": "${env:USERPROFILE}/.eide/tools/openocd_7a1adfbec_mingw32/bin/openocd.exe",
      "gdbPath": "${env:USERPROFILE}/.eide/tools/gcc_arm/bin/arm-none-eabi-gdb.exe",
      "searchDir": [
        "${env:USERPROFILE}/.eide/tools/openocd_7a1adfbec_mingw32/share/openocd/scripts"
      ],
      "configFiles": [
        "${workspaceFolder}/openocd_dap.cfg"
      ],
      "preLaunchTask": "RL: build",
      "postLaunchCommands": [
        "monitor reset run"
      ],
      "postRestartCommands": [
        "monitor reset run"
      ],
      "showDevDebugOutput": "none",
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 1
      }
    }
  ]
}
