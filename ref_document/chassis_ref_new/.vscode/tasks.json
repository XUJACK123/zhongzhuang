{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "make: bench",
      "type": "process",
      "command": "make",
      "args": [
        "-j32",
        "TEST_MOTOR=1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "make: default",
      "type": "process",
      "command": "make",
      "args": [
        "-j32",
        "TEST_MOTOR=0"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "make: test",
      "type": "process",
      "command": "make",
      "args": [
        "test",
        "-j8"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "make: clean",
      "type": "process",
      "command": "make",
      "args": [
        "clean"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "flash: bench (ST-LINK)",
      "type": "process",
      "command": "C:/Users/xuyue/.eide/tools/openocd_7a1adfbec_mingw32/bin/openocd.exe",
      "args": [
        "-s",
        "C:/Users/xuyue/.eide/tools/openocd_7a1adfbec_mingw32/share/openocd/scripts",
        "-f",
        "interface/stlink.cfg",
        "-f",
        "target/stm32h7x.cfg",
        "-c",
        "program {${workspaceFolder}/build/bench/chassis_torque_base.elf} verify reset exit"
      ],
      "dependsOn": "make: bench",
      "problemMatcher": []
    },
    {
      "label": "flash: default (ST-LINK)",
      "type": "process",
      "command": "C:/Users/xuyue/.eide/tools/openocd_7a1adfbec_mingw32/bin/openocd.exe",
      "args": [
        "-s",
        "C:/Users/xuyue/.eide/tools/openocd_7a1adfbec_mingw32/share/openocd/scripts",
        "-f",
        "interface/stlink.cfg",
        "-f",
        "target/stm32h7x.cfg",
        "-c",
        "program {${workspaceFolder}/build/default/chassis_torque_base.elf} verify reset exit"
      ],
      "dependsOn": "make: default",
      "problemMatcher": []
    }
  ]
}
